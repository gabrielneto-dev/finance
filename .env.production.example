# Produção do Finance no servidor de casa (SPEC-0005, Marco 0).
# Copie para .env.production na raiz do projeto, preencha e rode: chmod 600 .env.production
# Valores sem aspas. Nunca commite o .env.production (o .gitignore já o exclui).

# Endereço público, sem barra no fim. Precisa ser https://.
APP_ORIGIN=https://finance.vetracompany.com.br

# Fica vazio na produção: a chave local só vale em 127.0.0.1.
FINANCE_LOCAL_KEY_HASH=

# Único e-mail aceito no login. É o mesmo do usuário criado no Supabase.
FINANCE_OWNER_EMAIL=

# Supabase: Project Settings → API Keys. Use a chave publicável, nunca a service_role.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Pluggy: as mesmas credenciais da aplicação usada hoje.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_SANDBOX=0

# Id do Item MeuPluggy atual, para "Importar conexão existente" sem nova autorização. Opcional.
PLUGGY_EXISTING_ITEM_ID=

# Segredo do webhook. Gere com: openssl rand -hex 32
PLUGGY_WEBHOOK_SECRET=

# Minutos entre consultas do worker à Pluggy (padrão 60, mínimo 15).
PLUGGY_POLL_MINUTES=
