# Postgres
DATABASE_URL="postgresql://finance:finance@localhost:5432/finance?schema=public"

# API interna (Next.js)
PORT=3000
API_KEY="troque-por-um-segredo-forte"
API_BASE_URL="http://localhost:3000"

# WhatsApp gateway
# Número secundário (não o principal!) que ficará logado no bot, dono da sessão Baileys.
WA_SESSION_PATH="./data/wa-session"
# Números autorizados a enviar comandos, formato E.164 sem "+", separados por vírgula.
# É o(s) número(s) de QUEM MANDA a mensagem para o bot, não o número do bot.
ALLOWED_PHONES="5511999999999"

# Parsing por LLM (fallback para linguagem natural)
# LLM_PROVIDER escolhe qual API é usada: "anthropic" (default) ou "groq".
# Preencha só as credenciais do provedor escolhido.
LLM_PROVIDER="groq"
LLM_CONFIDENCE_THRESHOLD=0.6

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
