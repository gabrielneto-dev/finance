{
  "name": "finance-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node --import ./scripts/load-env.mjs node_modules/next/dist/bin/next dev",
    "build": "next build --webpack",
    "start": "node --import ./scripts/load-env.mjs node_modules/next/dist/bin/next start",
    "worker": "node --env-file-if-exists=.env --env-file-if-exists=../../.env scripts/worker.mjs",
    "webhooks": "node --env-file-if-exists=.env --env-file-if-exists=../../.env scripts/register-webhooks.mjs",
    "test": "node --test --test-isolation=none"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-pluggy-connect": "^2.8.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
