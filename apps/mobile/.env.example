# Configuração do app Finance. Copie para .env e preencha. Tudo com EXPO_PUBLIC_ vai dentro do app:
# use só valores públicos. Nunca coloque aqui a chave secreta do Supabase nem credenciais da Pluggy.

# Endereço do backend, sem barra no fim. Produção: https://finance.vetracompany.com.br
EXPO_PUBLIC_API_URL=
# Supabase: URL do projeto e chave publicável (Project Settings → API Keys).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
